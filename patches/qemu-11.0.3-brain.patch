+- (void)setScanout:(QemuCocoaViewScanout)scanout
+{
+    COCOA_DEBUG("QemuCocoaView: setScanout:%d\n", scanout);
+    if (_scanout != scanout) {
+        _scanout = scanout;
+        [self.cursorLayer removeFromSuperlayer];
+#ifdef CONFIG_OPENGL
+        [self.glLayer removeFromSuperlayer];
+#endif
+#ifdef USE_METAL
